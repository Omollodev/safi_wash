# =====================================================================
#  Safi Wash -- environment template
# =====================================================================
#  This is a COMMUNITY project: anyone may use it, learn from it and
#  improve it. If it helps you, please give the repo a star on GitHub
#  and share it with other students and developers.
#
#  HOW TO USE
#    1. Copy this file:   cp .env.example .env
#    2. Fill in your own values in .env
#    3. NEVER commit .env (it is already in .gitignore)
#
#  Every value below is a harmless placeholder, not a real secret.
# =====================================================================

# ---- Django -----------------------------------------------------------
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
# Needed in production when behind HTTPS, e.g. https://your-domain.example
CSRF_TRUSTED_ORIGINS=

# ---- Database ---------------------------------------------------------
# Leave empty to use SQLite (zero setup). For PostgreSQL:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# ---- Docker Compose (production stack) --------------------------------
# docker-compose.yml builds DATABASE_URL for you from these. Use letters and digits only.
POSTGRES_DB=carwash
POSTGRES_USER=carwash
POSTGRES_PASSWORD=replace-me-with-a-long-random-password
WEB_PORT=8000
# Keep True on the internet (HTTPS only). Set False ONLY to try the containers on http://localhost.
SECURE_SSL_REDIRECT=True

# ---- Demo data --------------------------------------------------------
# Optional: password for `make seed`. Leave empty and a random one is printed instead.
DEMO_PASSWORD=

# ---- Your business (shown on the site and printed job cards) ----------
BUSINESS_NAME=Safi Wash
BUSINESS_PHONE=+254700000000
BUSINESS_EMAIL=info@example.com
BUSINESS_ADDRESS=Your town, Kenya
BUSINESS_HOURS=Mon-Sat 8:00-18:00

# ---- Email (customer email verification) ------------------------------
# Default prints emails to your terminal -- perfect for development.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-smtp-user
# EMAIL_HOST_PASSWORD=your-smtp-password

# ---- SMS via Africa's Talking (optional) ------------------------------
SMS_ENABLED=False
# AT_USERNAME=sandbox
# AT_API_KEY=your-africas-talking-api-key

# ---- M-Pesa (optional) ------------------------------------------------
# fake       = simulated payments, no network (default, best for learning)
# sandbox    = Safaricom Daraja sandbox (https://developer.safaricom.co.ke)
# production = live money -- only when you are ready
MPESA_MODE=fake
# MPESA_CONSUMER_KEY=your-daraja-consumer-key
# MPESA_CONSUMER_SECRET=your-daraja-consumer-secret
# MPESA_SHORTCODE=174379
# MPESA_PASSKEY=your-daraja-passkey
# MPESA_CALLBACK_BASE_URL=https://your-public-domain.example
# MPESA_CALLBACK_TOKEN=any-long-random-string
